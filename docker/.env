# Local development defaults for the Nalanda validation environment.
# These are NOT secrets: they only ever apply to the containers started from
# docker/docker-compose.yml on a developer machine. Override any of them by
# exporting the variable or editing this file - never edit the compose file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=validation
POSTGRES_USER=validation
POSTGRES_PASSWORD=validation
POSTGRES_PORT=5432

# --- Kafka ------------------------------------------------------------------
KAFKA_PORT=9092

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=validation-documents
